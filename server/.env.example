# Server Port (cPanel will assign automatically or use 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local/cPanel MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/home_management_db

# Allowed Client Origin (Vercel URL or * for all)
CLIENT_URL=*

# Seed initial data on first start (true/false)
SEED_ON_START=false
